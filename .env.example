# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development, and set the same values
# in the Vercel project settings for production. Nothing here is secret until
# you fill it in; .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# The canonical origin. Used for <link rel="canonical">, OpenGraph URLs,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://gathaithicoffee.co.ke

# ── Sample request form ──────────────────────────────────────────────────────
# Which adapter delivers the enquiry. `console` (the default) validates and
# logs it without sending anything. See src/lib/email/adapter.ts.
#   console | resend | smtp
EMAIL_PROVIDER=console

# Where sample requests are delivered, and what they are sent from.
SAMPLE_REQUEST_TO=marketing@gathaithicoffee.co.ke
SAMPLE_REQUEST_FROM=Gathaithi website <website@gathaithicoffee.co.ke>

# Only needed when EMAIL_PROVIDER=resend. https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Editorial ────────────────────────────────────────────────────────────────
# Set to 1 to underline every unverified statistic on the page, so they can be
# found and checked in one pass. Never set this in production.
# NEXT_PUBLIC_SHOW_UNVERIFIED=1
